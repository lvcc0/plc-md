# --- variables --- # 

# lattice constant of Al
variable a equal 4.05

# box length in each dimension (in lattice spacings)
variable xlen index 12  # along [1 -1  0]
variable ylen index 6   # along [1  1 -2]
variable zlen index 12  # along [1  1  1]

# lattice spacing (from logs)
variable dx equal 5.7275649
variable dy equal 6.6136223
variable dz equal 7.0148058

# burgers vector
variable b equal $a/${dx}/2

# getting datetime data for naming the dump & log files
if "$(is_defined(variable, dump_name) == 0)" then &
  "shell date +%Y-%m-%d_%H-%M > date.tmp" &
  "variable timestamp file date.tmp" &
  "shell rm date.tmp" &
  "variable dump_name index dumps/${xlen}x${ylen}x${zlen}.${timestamp}.atom" &
  "variable log_name  index logs/${xlen}x${ylen}x${zlen}.${timestamp}.log"

# --- general settings --- #

# create directories if they don't exist
shell mkdir logs
shell mkdir dumps

# logging results
log ${log_name}
shell rm log.lammps

units       metal
dimension   3
atom_style  atomic
boundary    p p p

# --- simulation box --- #

lattice fcc $a orient x  1 -1  0 &
               orient y  1  1 -2 &
               orient z  1  1  1

region simbox block 0 ${xlen} &
                    0 ${ylen} &
                    0 ${zlen} units lattice

create_box    1 simbox
create_atoms  1 region simbox

# --- eam/alloy potential --- #

pair_style  eam/alloy
pair_coeff  * * potentials/NiAl_Mishin_2004.eam.alloy Al

neighbor      2.0 bin
neigh_modify  delay 5

# --- delete atoms in a plane (dislocation) --- #

variable xhalf equal ${xlen} / 2
variable yhalf equal ${ylen} / 2
variable zhalf equal ${zlen} / 2

region plane_in  plane $(v_xhalf-0.1) v_yhalf v_zhalf  1 0 0  side in
region plane_out plane $(v_xhalf+0.1) v_yhalf v_zhalf  1 0 0  side out
region top_half  block INF INF  INF INF  v_zhalf INF

region plane_region intersect 3 plane_in plane_out top_half
delete_atoms region plane_region

change_box all z delta 0 10 units box  # adding some space above

# --- simulation & saving the data --- #

#write_data dumps/!start.data  # pre relaxation state (first frame)

thermo        10
thermo_style  custom step pe etotal pxx pyy pzz

dump fulldump all atom 10 ${dump_name}

# energy minimization
minimize 1e-25 1e-25 10000 5000

#write_data dumps/!relaxed.data  # post relaxation state

# --- rigid shift --- #

compute zmax all reduce max z

# initialize the system for computes to compute
run 0

variable z_top_thresh equal "c_zmax - 2.5"
variable z_bot_thresh equal 2.0

variable is_top atom "z > v_z_top_thresh"
variable is_bot atom "z < v_z_bot_thresh"

group top_layer variable is_top
group bot_layer variable is_bot
group mid_layer subtract all top_layer bot_layer

variable shift equal 8 # Angst/ps 

fix top_move top_layer move variable NULL NULL NULL  v_shift NULL NULL
fix top_frz  top_layer setforce 0.0 0.0 0.0

fix mid_nvt mid_layer nvt temp 300.0 300.0 0.1
fix bot_frz bot_layer setforce 0.0 0.0 0.0

run 2000

#write_data dumps/!shifted.data  # post shifting state