# --- variables --- # 

# lattice constant of Al
variable a equal 4.05

# box length in each dimension (in lattice spacings)
variable xlen equal 42  # along [1 -1  0]
variable ylen equal 6   # along [1  1 -2]
variable zlen equal 18  # along [1  1  1]

# lattice spacing (from logs)
variable dx equal 5.7275649
variable dy equal 6.6136223
variable dz equal 7.0148058

# burgers vector
# NOTE: idrk if this is the right formula :)
variable b equal $a/${dx}

# --- general settings --- #

units       metal
dimension   3
atom_style  atomic
boundary    p p p

# --- simulation box --- #

lattice fcc $a orient x  1 -1  0 &
               orient y  1  1 -2 &
               orient z  1  1  1

region simbox block 0 ${xlen} &
                    0 ${ylen} &
                    0 ${zlen} units lattice

create_box    1 simbox
create_atoms  1 region simbox

# --- EAM potential --- #

mass        1 26.981539 # Al mass
pair_style  eam
pair_coeff  * * Al_jnp.eam

neighbor      2.0 bin
neigh_modify  delay 5

# --- delete atoms in a plane (dislocation) --- #

variable xhalf equal ${xlen} / 2
variable yhalf equal ${ylen} / 2
variable zhalf equal ${zlen} / 2

region plane_in  plane $(v_xhalf-0.1) v_yhalf v_zhalf  1 0 0  side in
region plane_out plane $(v_xhalf+0.1) v_yhalf v_zhalf  1 0 0  side out
region top_half  block INF INF  INF INF  v_zhalf INF

region plane_region intersect 3 plane_in plane_out top_half
delete_atoms region plane_region

# NOTE: is it really real? is this physically accurate?
# accounting for the ABAB fcc structure*
#region edge_plane block INF 0.2  INF INF  INF INF
#delete_atoms region edge_plane

# *by deleting a single plane of atoms, we disrupted ABAB fcc structure
#  so now we have to delete another one whole plane for balancing it out.
#  or so i think :)

change_box all z delta 0 10 units box  # adding some space above

# --- simulation & saving the data --- #

# create "dumps/" directory if it doesn't exist
shell mkdir dumps

write_data dumps/!pre.data  # pre-relaxation state (first frame)

thermo        10
thermo_style  custom step pe etotal pxx pyy pzz

# getting datetime data for naming the dump file
shell date +%Y-%m-%d_%H-%M > date.tmp
variable timestamp file date.tmp
shell rm date.tmp

dump fulldump all atom 10 dumps/dump.${timestamp}.atom
minimize 1e-25 1e-25 10000 5000
run 0

write_data dumps/!post.data  # post-relaxation state (last frame)
