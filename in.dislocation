# this file creates an ideal fcc lattice, cuts a half-plane in the middle and minimizes the energy of the system.
# result is a relaxed system with a dislocation in the middle (ideally).

include common.lmp

# getting datetime data for naming files
if "$(is_defined(variable, file_name) == 0)" then &
  "shell date +%Y-%m-%d_%H-%M > timestamp.tmp" &
  "variable timestamp file timestamp.tmp" &
  "shell rm timestamp.tmp" &
  "variable file_name index dislocation.${xlen}x${ylen}x${zlen}.${timestamp}"

# --- general settings --- #

# create directories if they don't exist
shell mkdir logs/dislocations
shell mkdir dumps/dislocations
shell mkdir restarts/dislocations

# logging results
log logs/dislocations/${file_name}.log
shell rm log.lammps

# --- simulation box --- #

region simbox block 0 ${xlen} &
                    0 ${ylen} &
                    0 ${zlen} units lattice

create_box   1 simbox
create_atoms 1 region simbox

pair_style eam/alloy
pair_coeff * * potentials/NiAl_Mishin_2004.eam.alloy Al

# --- delete atoms in a plane (dislocation) --- #

variable xhalf equal ${xlen} / 2
variable yhalf equal ${ylen} / 2
variable zhalf equal ${zlen} / 2

region plane_in  plane $(v_xhalf-0.1) v_yhalf v_zhalf  1 0 0  side in
region plane_out plane $(v_xhalf+0.1) v_yhalf v_zhalf  1 0 0  side out
region top_half  block INF INF  INF INF  v_zhalf INF

region plane_region intersect 3 plane_in plane_out top_half
delete_atoms region plane_region

change_box all z delta 0 10 units box  # adding some space above

# --- simulation & saving the data --- #

thermo        10
thermo_style  custom step pxx pyy pzz pxy pyz pxz

dump fulldump all custom 10 dumps/dislocations/${file_name}.atom id x y z

# energy minimization
timestep 0.01
minimize 0.0 1.0e-8 10000 100000

write_restart restarts/dislocations/${file_name}.restart