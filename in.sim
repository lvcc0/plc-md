include common.ini

read_data min.data
pair_style eam
pair_coeff * * Al_jnp.eam

variable xx equal ${box_size} / 2 * ${dx}
variable yy equal ${box_size} / 2 * ${dy}
variable zz equal ${box_size} / 2 * ${dz}

region plane_in  plane $(v_xx-1) v_yy v_zz  1 0 0  side in
region plane_out plane $(v_xx+1) v_yy v_zz  1 0 0  side out
region top_half  block INF INF  INF INF  v_zz INF

region plane_region intersect 3 plane_in plane_out top_half
delete_atoms region plane_region compress yes

thermo 200
thermo_style custom step temp pe etotal press fmax

min_style cg
timestep 0.005

fix mynve      all nve
fix mylangevin all langevin 300.0 300.0 0.1 1337

dump mydump all atom 100 dump.lammpstrj

minimize 1.0e-6 1.0e-8 10000 100000
run 50000
