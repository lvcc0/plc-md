include common.ini
 
# defining face-centered cubic lattice with a lattice constant of Al.
lattice fcc ${lattice_size} orient x 1 -1  0 &
                            orient y 1  1 -2 &
                            orient z 1  1  1

region simbox block 0 ${box_size} &
                    0 ${box_size} &
                    0 ${box_size} units lattice

create_box 1 simbox
create_atoms 1 region simbox

# some settings
mass 1 26.981539 # Al mass
pair_style eam # embedded alloy method
pair_coeff * * Al_jnp.eam

# minimizing energy
neighbor 2.0 bin
neigh_modify every 20 delay 0 check no
minimize 1.0e-4 1.0e-6 1000 10000

# save system after energy minimization
write_data min.data
