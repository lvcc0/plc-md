include src/common.ini

# getting datetime data for naming files
if "$(is_defined(variable, file_name) == 0)" then &
  "shell date +%Y-%m-%d_%H-%M > timestamp.tmp"    &
  "variable timestamp file timestamp.tmp"         &
  "shell rm timestamp.tmp"                        &
  "variable file_name string equilibration.${timestamp}"

# logging results
log logs/equilibrations/${file_name}.log
shell rm log.lammps

# if atom file name is not given, get the last modified one
if "$(is_defined(variable, atom_file) == 0)" then &
  "shell ls -t atoms.* | head -1 > atom_file.tmp" &
  "variable atom_file file atom_file.tmp"         &
  "shell rm atom_file.tmp"

read_data ${atom_file}
print "reading data from ${atom_file}"

# uncomment to enable set number seed (debugging purposes)
#variable seed equal 1337

# getting time-based random seed to use in production runs
if "$(is_defined(variable, seed) == 0)" then &
  "shell date +%N > seed.tmp"                &
  "variable seed file seed.tmp"              &
  "shell rm seed.tmp"

# ---                      --- #
# --- system configuration --- #
# ---                      --- #

mass 1 ${al_mass}
mass 2 ${mg_mass}

pair_style eam/fs                      # Finnis-Sinclair format Embedded Atom Method
pair_coeff * * ${potential_almg} Al Mg # 1-1, 1-2, 2-2, where 1=Al, 2=Mg (because the potential file is made this way)

# --- dividing into regions --- #

region top_region block INF                  INF &
                        $(ly-v_layer_thresh) INF &
                        INF                  INF units box

region bot_region block INF INF            &
                        INF v_layer_thresh &
                        INF INF            units box

group top_layer region top_region                # moving rigid top layer
group bot_layer region bot_region                # static rigid bottom layer
group mobile    subtract all top_layer bot_layer # mobile middle layer (just atoms)

group al_group  type      1
group al_mobile intersect al_group mobile

# default values (used if values below are not uncommented)
#neighbor 2.0 bin
#neigh_modify delay 0 every 1 check yes

# performance tuned
#neighbor 2.0 bin
#neigh_modify delay 10 every 2 check yes

# stability tuned (set if "Dangerous builds" != 0)
#neighbor 3.0 bin
#neigh_modify delay 0 every 1 check yes

# ---                                    --- #
# --- STEP 1: minimize system energy     --- #
# ---         and equilibrate the system --- #
# ---                                    --- #

timestep ${eq_run_timestep}

#compute pot_energy  all    pe/atom
#compute stress      all    stress/atom NULL
compute mobile_temp mobile temp # temperature of moving atoms only

thermo        ${eq_dump_freq}
thermo_modify temp mobile_temp
thermo_style  custom step temp pe fnorm fmax press lx ly lz

dump 1 all custom ${eq_dump_freq} &
     dumps/equilibrations/${file_name}.atom  &
     id type x y z

# boundary conditions (freezing planes parallel to the dislocation's slip plane)
fix TOPFIX top_layer setforce 0.0 0.0 NULL
fix BOTFIX bot_layer setforce 0.0 0.0 NULL
velocity top_layer set 0.0 0.0 0.0
velocity bot_layer set 0.0 0.0 0.0

print "###                   ###"
print "## energy minimization ##"
print "## (dislocation)       ##"
print "###                   ###"

min_style fire
min_modify dmax 0.005
minimize 0.0 1.0e-3 10000 100000

print "###                   ###"
print "## energy minimization ##"
print "## (dislocation+Mg)    ##"
print "###                   ###"

# adding Mg atoms to the system
set group al_mobile type/fraction 2 ${mg_frac} ${seed}

min_modify dmax 0.005
minimize 0.0 1.0e-3 10000 100000

print "###                          ###"
print "## energy minimization        ##"
print "## (dislocation+Mg+vacancies) ##"
print "###                          ###"

# adding vacancies to the system
delete_atoms random fraction ${vac_frac} yes al_mobile NULL ${seed}
reset_atoms  id

min_modify dmax 0.005
minimize 0.0 1.0e-3 10000 100000

# --- final minimization --- #

min_style cg
minimize 0.0 1.0e-6 10000 100000

# --- equilibration --- #

# set initial atom velocities
velocity mobile create ${desired_temp} ${seed} units box dist gaussian loop all mom yes rot yes

fix EQ mobile nvt temp ${desired_temp} ${desired_temp} 0.5

print "###             ###"
print "## equilibration ##"
print "###             ###"

run ${eq_run_steps}

unfix EQ

# NOTE: perhaps i can skip unfixing/fixing the nvt fix and rock with it till the end

# ---                           --- #
# --- STEP 2: MC/MD segregation --- #
# ---                           --- #

fix MD mobile nvt temp ${desired_temp} ${desired_temp} 0.5
fix MC mobile atom/swap 100 20 ${seed} ${desired_temp} types 1 2 ke yes

print "###                  ###"
print "## Mg segregation run ##"
print "###                  ###"

run ${seg_run_steps}

unfix MD
unfix MC
unfix TOPFIX
unfix BOTFIX

write_restart restarts/equilibrations/${file_name}.restart
