# NOTE: does NOT work, i did't rework this one and don't think i will!

include src/common.ini

# if restart file name is not given, get the last modified one
if "$(is_defined(variable, restart_file) == 0)" then                 &
  "shell ls -t restarts/equilibrations | head -1 > restart_file.tmp" &
  "variable restart_file file restart_file.tmp"                      &
  "shell rm restart_file.tmp"

read_restart restarts/equilibrations/${restart_file}

# getting datetime data for naming files
if "$(is_defined(variable, file_name) == 0)" then &
  "shell date +%Y-%m-%d_%H-%M > timestamp.tmp"    &
  "variable timestamp file timestamp.tmp"         &
  "shell rm timestamp.tmp"                        &
  "variable file_name string shear-soft.${timestamp}"

# --- general settings --- #

# logging results
log logs/shears/${file_name}.log
shell rm log.lammps

pair_style eam/alloy
pair_coeff * * ${potential_al} Al

# --- variables --- #

# note: perhaps i can do smth to not copy these lines from previous file

region top_region block INF                  INF &
                        $(ly-v_layer_thresh) INF &
                        INF                  INF units box

region bot_region block INF INF            &
                        INF v_layer_thresh &
                        INF INF            units box

group top_layer region top_region                # mobile rigid top layer 
group bot_layer region bot_region                # static rigid bottom layer
group mobile    subtract all top_layer bot_layer # mobile middle layer (just atoms)

# ---                                                                --- #
# --- STEP 3: apply constant force to calculate dislocation velocity --- #
# ---                                                                --- #

reset_timestep 0

timestep ${shear_run_timestep}

# number of atoms in top layer
variable ntop equal count(top_layer)

# force applied to the upper layer to move it, [N]
variable shearforce equal v_shear_sigma*(lx*ly)/(v_ntop*v_eV_to_J)

# define temperature
compute mobile_temp mobile temp

# define boundary velocities
velocity top_layer set 0.0 0.0 0.0 units box
velocity bot_layer set 0.0 0.0 0.0 units box

# define boundary conditions
fix 1 top_layer setforce NULL 0.0 NULL
fix 2 bot_layer setforce 0.0  0.0 NULL
fix 3 top_layer aveforce ${shearforce} 0.0 0.0
fix 4 top_layer rigid    group 1 top_layer

fix 5 mobile nve

thermo        100
thermo_modify temp mobile_temp
thermo_style  custom step pe ke temp pxx pyy pzz pxy pyz pxz

# each frame is taken after 100 timesteps, so actual time elapsed per frame is:
# 100 * 2e-15 = 2e-13

dump 1 all custom ${shear_dump_freq} &
     dumps/shears/${file_name}.atom  &
     id x y z

print "###                                         ###"
print "## shear modelling (applying constant force) ##"
print "###                                         ###"

run ${shear_run_steps}
