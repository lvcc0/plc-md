# this file contains common stuff for all the other files

# --- variables --- #

variable desired_temp equal 300.0  # [K]
variable sigma equal 150.0  # [bar] = [10^5 Pa]

# miscellaneous control variables
variable temperature_equil_time equal 2000
variable shear_run_time equal 50000
variable eV_to_J equal 1602176.634
# 1 eV = 1.602176634e-19, but we use some other non-standard stuff, so we use it like this
# [bar*Ang*Ang] = [10^5*10^10*10^10] = [10^25] (in fourmula for force)

# lattice constant of Al
variable a equal 4.05

# box length in each dimension (in lattice spacings)
variable xlen index 24  # along [1 -1  0]
variable ylen index 6   # along [1  1 -2]
variable zlen index 24  # along [1  1  1]

# lattice spacing (from logs)
variable dx equal 5.7275649
variable dy equal 6.6136223
variable dz equal 7.0148058

# burgers vector
variable b equal $a/${dx}/2

# --- system definition --- #

units      metal
dimension  3
atom_style atomic
boundary   p p p  # note: might make z shrink-wrapped

lattice fcc $a orient x  1 -1  0 &
               orient y  1  1 -2 &
               orient z  1  1  1

# --- eam/alloy potential --- #

neighbor     2.0 bin
neigh_modify delay 5
